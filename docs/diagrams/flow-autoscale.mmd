flowchart TD
    S(["Кадр малювання"]) --> G["Зібрати значення Y: вузли + вибірка кривих (400 точок) + відрізки залишків"]
    G --> F{"Увімкнено «Фокус на вузлах»?"}
    F -- "так" --> G2["Брати лише значення вузлів і відрізків"]
    F -- "ні" --> MM
    G2 --> MM["lo = min, hi = max (лише скінченні значення; для графіка залишків додати 0)"]
    MM --> FL{"hi − lo ≈ 0 ?"}
    FL -- "так" --> EXP["Розширити діапазон: ± max(|lo|·0.1; 1)"]
    FL -- "ні" --> PAD
    EXP --> PAD["Відступ 8% зверху й знизу"]
    PAD --> X["Вісь X: [x_min, x_max] вузлів (+20% при екстраполяції) та відступ 3%"]
    X --> SM{"Йде анімація?"}
    SM -- "так" --> LERP["Плавно наблизити поточні межі до цільових (коеф. 0.2 за кадр)"]
    SM -- "ні" --> SNAP["Використати цільові межі"]
    LERP --> TK["niceTicks: «гарні» позначки 1·10ⁿ, 2·10ⁿ, 5·10ⁿ"]
    SNAP --> TK
    TK --> E(["Малювання осей, сітки, кривих"])
