flowchart TD
    S(["lagrangeEval(xs, ys, x)"]) --> V{"Вузли різні та скінченні?"}
    V -- "ні" --> ERR(["Помилка: некоректні вузли"])
    V -- "так" --> Q{"x збігається з вузлом xₖ?"}
    Q -- "так" --> RET1(["повернути yₖ"])
    Q -- "ні" --> INIT["sum = 0; k = 0"]
    INIT --> LP{"k < n ?"}
    LP -- "так" --> T["term = yₖ; j = 0"]
    T --> J{"j < n ?"}
    J -- "так" --> JJ{"j ≠ k ?"}
    JJ -- "так" --> MUL["term = term · (x − xⱼ) / (xₖ − xⱼ)"] --> JN["j = j + 1"] --> J
    JJ -- "ні" --> JN
    J -- "ні" --> ADD["sum = sum + term; k = k + 1"] --> LP
    LP -- "ні" --> RET2(["повернути sum"])
