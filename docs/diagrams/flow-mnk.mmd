flowchart TD
    S(["fitPolynomial(xs, ys, m)"]) --> C{"m ≤ n − 1 ?"}
    C -- "ні" --> ERR(["Помилка: надто великий ступінь"])
    C -- "так" --> NRM["Нормування: c = (xmin + xmax)/2, s = (xmax − xmin)/2, tᵢ = (xᵢ − c)/s"]
    NRM --> A["Дизайн-матриця A[i][j] = tᵢʲ, j = 0…m"]
    A --> QR["Для k = 0…m: відображення Хаусхолдера H_k,<br/>зануляє піддіагональні елементи стовпця k;<br/>застосувати H_k до A і до вектора b = y"]
    QR --> RK{"|R_kk| достатньо великий?"}
    RK -- "ні" --> RANK(["Помилка: виродкова матриця"])
    RK -- "так" --> BS["Зворотна підстановка R·a = Qᵀb → коефіцієнти a₀…a_m"]
    BS --> FIT["ŷᵢ = Σ aⱼ·tᵢʲ (Горнер)"]
    FIT --> RES["Залишки rᵢ = yᵢ − ŷᵢ; SSE, RMSE, R²"]
    RES --> OUT(["повернути модель {coef, predict, fitted, residuals}"])
